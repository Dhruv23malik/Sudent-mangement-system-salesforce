<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Enrollment_Date_Cannot_Be_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Enrollment_Date__c &gt; TODAY()</errorConditionFormula>
    <errorMessage>Enrollment Date cannot be in the future.</errorMessage>
</ValidationRule>
